<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The drand adapter for NCode.Randomness: fetches rounds of the League of Entropy's quicknet chain, or takes saved round documents offline, and verifies their BLS12-381 threshold signatures against the pinned group public key before any byte is used.</Description>
    <PackageTags>random randomness-beacon drand league-of-entropy bls12-381 cryptography</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Neo.Cryptography.BLS12_381" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NCode.Randomness\NCode.Randomness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="NCode.Randomness.Drand.Tests" />
  </ItemGroup>
</Project>

---
// Copyright © NCode Group
// SPDX-License-Identifier: Apache-2.0
//
// One way to get random values on "Which API?": the API, its call, three badges (safe for secrets, reproducible by
// others, needs dependency injection), what to watch for, and a link to its guide, from
// docs/site/_components/data/uses.json. Put the compiled call inside it as a sample include. `id` is the card's
// anchor there, written as a literal so the link check sees it.
// Usage:
//   <UseCard id="inject-isecurerandom" use="secure-random">
//   ```cs snippet=SiteWhichApiSecureRandom
//   ```
//   </UseCard>
import { Status } from '@ncodegroup/docs/components';
import uses from '@site/components/data/uses.json';
import { inline, sitePath } from '@site/components/lib/text';

interface Props {
  id: string;
  use: string;
}
const { id, use } = Astro.props;
type Use = (typeof uses.uses)[number];
const card = uses.uses.find((u) => u.id === use) as Use | undefined;
if (!card) throw new Error(`[which api] no use "${use}" in docs/site/_components/data/uses.json`);
if (card.anchor !== id) throw new Error(`[which api] <UseCard use="${use}"> needs id="${card.anchor}"`);
const badges = [
  { label: 'Safe for secrets', on: card.secrets },
  { label: 'Reproducible by others', on: card.reproducible },
  { label: 'Needs dependency injection', on: card.injection },
];
---

<article class:list={['ucard', 'not-content']} id={id} data-use={card.id} aria-labelledby={`${id}-title`}>
  <header class="ucard__head">
    <span class="ucard__group">{card.kind}</span>
    <h3 class="ucard__title" id={`${id}-title`} set:html={inline(card.name)} />
    <p class="ucard__use" set:html={inline(card.use)} />
  </header>
  <ul class="ucard__badges" aria-label="Properties">
    {badges.map((badge) => (
      <li>
        <Status state={badge.on ? 'success' : 'off'}>
          {badge.label}: {badge.on ? 'yes' : 'no'}
        </Status>
      </li>
    ))}
  </ul>
  <div class="ucard__code">
    <slot />
  </div>
  <dl class="ucard__facts">
    <div>
      <dt>Watch for</dt>
      <dd set:html={inline(card.watchFor)} />
    </div>
  </dl>
  <p class="ucard__links">
    <a class="ucard__guide" href={sitePath(card.guide)}>The guide</a>
  </p>
</article>

<style>
  .ucard {
    scroll-margin-top: calc(var(--sl-nav-height) + var(--nc-space-5));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--nc-space-4);
    margin-block: var(--nc-space-5);
    padding: var(--nc-space-5);
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-panel);
    background: var(--nc-color-surface);
    box-shadow: var(--nc-elevation-flush);
  }
  .ucard:target,
  .ucard.is-chosen {
    border-color: var(--nc-color-primary-text);
    box-shadow: 0 0 0 1px var(--nc-color-primary-text);
  }
  .ucard__head { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--nc-space-2); }
  .ucard__group {
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .ucard__title {
    margin: 0;
    color: var(--nc-color-text);
    font-size: var(--sl-text-xl);
    font-stretch: var(--nc-type-heading-stretch);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .ucard__title :global(code) { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); font-size: 0.82em; overflow-wrap: anywhere; }
  .ucard__use { margin: 0; color: var(--nc-color-text-secondary); }
  .ucard__badges { display: flex; flex-wrap: wrap; gap: var(--nc-space-2) var(--nc-space-5); margin: 0; padding: 0; list-style: none; font-size: var(--sl-text-sm); }
  .ucard__badges li { margin: 0; }
  .ucard__code :global(.expressive-code) { margin: 0; }
  .ucard__facts { display: grid; gap: var(--nc-space-3); margin: 0; }
  .ucard__facts > div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--nc-space-4); }
  .ucard__facts dt {
    padding-top: 0.1875rem;
    font-size: 0.6875rem;
    font-stretch: var(--nc-type-label-stretch);
    font-weight: 600;
    letter-spacing: var(--nc-type-label-tracking);
    text-transform: uppercase;
    color: var(--nc-color-text-muted);
  }
  .ucard__facts dd { margin: 0; font-size: var(--sl-text-sm); line-height: 1.5; }
  .ucard :global(code) { font-family: var(--nc-font-mono); font-stretch: var(--nc-type-code-stretch); }
  .ucard__facts :global(code),
  .ucard__use :global(code) {
    padding: 0.06em 0.3em;
    border: var(--nc-border-hair) solid var(--nc-color-border);
    border-radius: var(--nc-radius-plate);
    background: var(--nc-color-surface-sunken);
    font-size: 0.88em;
  }
  .ucard__links { display: flex; flex-wrap: wrap; gap: var(--nc-space-2) var(--nc-space-5); margin: 0; font-size: var(--sl-text-xs); }
  .ucard__links a { color: var(--nc-color-primary-text); text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .ucard__guide { font-weight: 600; }
  .ucard__guide::after { content: ' \2192'; }
  @media (max-width: 40rem) {
    .ucard { padding: var(--nc-space-4); }
    .ucard__facts > div { grid-template-columns: minmax(0, 1fr); gap: var(--nc-space-1); }
  }
</style>

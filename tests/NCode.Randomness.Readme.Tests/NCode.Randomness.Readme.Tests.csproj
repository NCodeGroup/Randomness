<Project Sdk="Microsoft.NET.Sdk">
  <!-- The README samples (ADR-1014). This project has no InternalsVisibleTo, so a sample sees only the public API, and
       its namespace is outside NCode.Randomness, so a sample's using directives are the ones a reader writes.
       samples.runsettings keeps the samples out of coverage. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ReadmeSamples</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../samples.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NCode.Randomness\NCode.Randomness.csproj" />
    <ProjectReference Include="..\..\src\NCode.Randomness.Curby\NCode.Randomness.Curby.csproj" />
    <ProjectReference Include="..\..\src\NCode.Randomness.Nist\NCode.Randomness.Nist.csproj" />
    <ProjectReference Include="..\..\src\NCode.Randomness.Drand\NCode.Randomness.Drand.csproj" />
  </ItemGroup>
  <Import Project="..\Shared\Recorded.props" />
</Project>

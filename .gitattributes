# Normalize text to LF in the repository and in working copies.
* text=auto eol=lf

# Windows command scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.snk binary

# Documents NIST served, kept byte for byte with their CRLF line endings.
tests/NCode.Randomness.Nist.Tests/Fixtures/*.json -text
tests/NCode.Randomness.Nist.Tests/Fixtures/*.pem -text
